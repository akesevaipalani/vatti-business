{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.vattibusiness.app",
  "productName": "VATTI BUSINESS",
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "files": [
    "electron/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": ".next/standalone",
      "to": "server",
      "filter": [
        "!node_modules"
      ]
    },
    {
      "from": ".next/standalone/node_modules",
      "to": "server/node_modules",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "build/icon.ico",
      "to": "icon.ico"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "VATTI BUSINESS",
    "uninstallDisplayName": "VATTI BUSINESS",
    "deleteAppDataOnUninstall": false,
    "artifactName": "VATTI BUSINESS Setup.${ext}"
  },
  "portable": {
    "artifactName": "VATTI BUSINESS Portable.${ext}"
  }
}
