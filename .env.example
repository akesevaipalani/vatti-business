# Central Database URL (PostgreSQL / Supabase)
# For local PostgreSQL testing:
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/vatti_business"

# For Supabase Cloud Deployment:
# Direct Connection (Port 5432):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
#
# Supabase Connection Pooler (Recommended for Multi-Device):
# DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# JWT Secret for Multi-Device Session Authentication
JWT_SECRET="vatti-super-secure-local-secret-key-business-2026-v1"

# Environment
NODE_ENV="development"
